parameters:
    level: 6
    tmpDir: var/cache/phpstan
    paths:
        - bin/
        - config/
        - public/
        - src/
        - tests/
    excludePaths:
        analyseAndScan:
            - var/*
            - docker/*
            - share/*
        analyse:
            - vendor/*
            - migrations/*
    checkExplicitMixed: true
    checkImplicitMixed: true
    checkMissingVarTagTypehint: true
    checkUninitializedProperties: true
    inferPrivatePropertyTypeFromConstructor: true
    reportUnmatchedIgnoredErrors: true
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
    ignoreErrors:
        # Persistence ORM entities используют factory pattern / Doctrine reflection
        - '#Class App\\Persistence\\Entity\\.* has an uninitialized property#'
        # Domain entities используют private constructor + static factory methods (DDD pattern)
        - '#Class App\\.*\\Domain\\Entity\\.* has an uninitialized property#'
        # Kernel::configureContainer — стандартный Symfony MicroKernelTrait метод
        - '#Method App\\Kernel::configureContainer\(\) is unused#'
        # method_exists — код Symfony Dotenv, всегда true в нашем окружении
        - '#Call to function method_exists\(\) with .* will always evaluate to true#'
        # Doctrine Repository @method PHPDoc с generic array типами (Persistence layer)
        - '#Class App\\Persistence\\Repository\\.* has PHPDoc tag @method for method .* with no value type specified in iterable type array#'
